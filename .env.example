# Adresse publique du site (sans slash final), utilisée pour le SEO et les e-mails
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# Adresse e-mail publique affichée sur le site (laisser vide pour la masquer)
NEXT_PUBLIC_CONTACT_EMAIL=

# Supabase (Project settings > API). La clé service_role reste côté serveur, jamais exposée au navigateur.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com) pour les e-mails. Le domaine de l'expéditeur doit être vérifié chez Resend.
RESEND_API_KEY=
RESEND_FROM="Brice Seguret <contact@exemple.fr>"
# Adresse qui reçoit les nouvelles demandes de projet
NOTIFY_EMAIL=
